# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — server-only, used to update order status after payment.
# Found in Supabase: Project Settings > API > service_role key. NEVER expose this in
# client-side code or commit it publicly — it bypasses all security rules (RLS).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Stripe — server-only secret key, used to create checkout sessions and verify payments.
# Found in Stripe: Developers > API keys > Secret key.
STRIPE_SECRET_KEY=your_stripe_secret_key

# PayPal (optional, not yet integrated)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# Email (optional, for order confirmations)
SENDGRID_API_KEY=your_sendgrid_api_key
